{
  "allowFrom": [],
  "defaultAgent": "opencode",
  "agents": {
    "opencode": {
      "command": "opencode",
      "args": ["acp"],
      "cwd": ".",
      "notifyPolicy": "none"
    }
  },
  "autoApprove": false,
  "webPort": 3210,
  "pluginsFile": "plugins.json",
  "streamFlushMinChars": 200,
  "streamFlushIdleMs": 3000,
  "channels": [
    { "type": "weixin", "id": "weixin-main", "enabled": true }
  ]
}
